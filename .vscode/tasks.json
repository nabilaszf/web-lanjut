{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Backend (FastAPI)",
            "type": "shell",
            "command": "${workspaceFolder}/backend/venv/Scripts/python.exe",
            "args": [
                "-m",
                "uvicorn",
                "app.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "options": {
                "cwd": "${workspaceFolder}/backend",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/backend"
                }
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "beginsPattern": "^(INFO|Uvicorn).*",
                    "endsPattern": "^.*Application startup complete.*$"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "group": "backend"
            }
        }
    ]
}